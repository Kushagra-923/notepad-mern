{
  "name": "notepad-mern",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "test": "node --test --test-force-exit \"tests/*.test.js\"",
    "e2e": "node e2e/run-all.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "playwright-core": "^1.64.1"
  }
}
